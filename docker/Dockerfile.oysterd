FROM rust:1.93-bookworm AS builder

RUN apt-get update && apt-get install -y protobuf-compiler cmake clang && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .
RUN cargo build --release -p oyster

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 oyster

COPY --from=builder /build/target/release/oysterd /usr/local/bin/oysterd

USER oyster
EXPOSE 3000
ENTRYPOINT ["oysterd"]
CMD ["serve"]

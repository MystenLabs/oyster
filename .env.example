# Oyster server configuration reference. Copy to .env (or export in the
# environment) and fill in the REPLACE_ME values. Only the variables you
# need must be set — everything has a default except the secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
#BIND_ADDR=0.0.0.0:3000
#DATABASE_URL=sqlite:oyster.db?mode=rwc          # or postgres://user:pass@host/db
#BLOB_STORE_PATH=blob_store

# Pearl (custodial wallet service)
#PEARL_GRPC_URL=http://127.0.0.1:50051
PEARL_SERVICE_SECRET=REPLACE_ME

# On-chain storage (omit to use the local filesystem blob store)
#SUI_RPC_URL=
#WALRUS_SYSTEM_OBJECT=
#WALRUS_STAKING_OBJECT=

# ---------------------------------------------------------------------------
# Self-serve web signup (/signup)
#
# Signup is enabled only when ALL FIVE of the values below are set; when
# none are set the signup routes are not mounted at all. Setting only
# some of them is a startup error (fail-fast against half-configured
# deployments).
# ---------------------------------------------------------------------------

# Public base URL of this server, used to build the Google OAuth
# redirect URI (<base>/signup/callback must be registered in the Google
# Cloud console).
#OYSTER_PUBLIC_BASE_URL=https://oyster.example.com

# Google Cloud console → APIs & Services → Credentials → OAuth 2.0
# Client ID (type: Web application).
#GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# Cloudflare dashboard → Turnstile → your widget. For local development
# Cloudflare publishes dummy keys that need no account:
#   always-pass sitekey:  1x00000000000000000000AA
#   always-pass secret:   1x0000000000000000000000000000000AA
#TURNSTILE_SITE_KEY=REPLACE_ME
#TURNSTILE_SECRET_KEY=REPLACE_ME

# Gating mode: open | waitlist | closed. Defaults to closed so that
# configuring the credentials never silently opens signup. `closed`
# still allows existing users to sign in.
#OYSTER_SIGNUP_MODE=waitlist

# Comma-separated email domains whose (Google-verified) users skip the
# waitlist queue.
#OYSTER_SIGNUP_ALLOWED_DOMAINS=example.com

# Maximum active admin keys per app on the web issuance path (the
# `oyster app` CLI bypasses this).
#OYSTER_MAX_ADMIN_KEYS_PER_APP=5

# DEV ONLY — point the signup flow at mock Google/Turnstile servers
# (see scripts/signup-testbed.sh, which sets these automatically).
# Never set these in production.
#GOOGLE_OAUTH_AUTH_URL=http://127.0.0.1:9081/auth
#GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:9081/token
#GOOGLE_OAUTH_JWKS_URL=http://127.0.0.1:9081/certs
#TURNSTILE_SITEVERIFY_URL=http://127.0.0.1:9081/siteverify

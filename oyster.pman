import "${args.walrus_dir}/walrus.pman" {
  working_dir = args.working_dir
  aggregator = true
}

arg working_dir {
  type = string
  default = module.dir + "/working_dir"
}

arg walrus_dir {
  type = string
}

env {
  RUST_LOG = "info,sui_types=warn"
}


job clean {
  env WORKING_DIR = args.working_dir
  run """
    echo "rm -rf $WORKING_DIR"
    rm -rf "$WORKING_DIR"
    rm -f oyster.db*
  """
}

job build {
  wait {
    after @clean
  }
  run "cargo build -p pearl -p oyster"
}

service pearl {
  wait {
    after @build
  }
  env {
    PEARL_BIND_ADDR = "127.0.0.1:50051"
    PEARL_SERVICE_SECRET = "testbed-secret"
    PEARL_MASTER_SEED = "deadbeefcafebabe1234567890abcdef0102030405060708090a0b0c0d0e0f10"
    RUST_LOG = "info"
  }
  run "./target/debug/pearl"
}

service oyster {
  wait {
    after @build
    after @walrus::deploy
    connect "127.0.0.1:50051"
    contains "${ args.working_dir }/client_config.yaml" {
      format = "yaml"
      key = "$.system_object"
      var = walrus_system_object
    }
    contains "${ args.working_dir }/client_config.yaml" {
      format = "yaml"
      key = "$.staking_object"
      var = walrus_staking_object
    }
    contains "${ args.working_dir }/sui_client.yaml" {
      format = "yaml"
      key = "$.envs[?(@.alias == 'local')].rpc"
      var = sui_rpc_url
    }
  }
  env {
    BIND_ADDR = "127.0.0.1:3000"
    DATABASE_URL = "sqlite:oyster.db?mode=rwc"
    PEARL_GRPC_URL = "http://127.0.0.1:50051"
    PEARL_SERVICE_SECRET = "testbed-secret"
    WALRUS_AGGREGATOR_URL = "http://127.0.0.1:31415"
    RUST_LOG = "info"
    WALRUS_SYSTEM_OBJECT = walrus_system_object
    WALRUS_STAKING_OBJECT = walrus_staking_object
    SUI_RPC_URL = sui_rpc_url
  }
  run "./target/debug/oysterd serve"
}

job setup {
  wait {
    http "http://127.0.0.1:3000/health" {
      status = 200
    }
    contains "${ args.working_dir }/sui_client.yaml" {
      format = "yaml"
      key = "$.envs[?(@.alias == 'local')].rpc"
      var = sui_rpc_url
    }
  }
  env {
    PEARL_BIND_ADDR = "127.0.0.1:50051"
    PEARL_SERVICE_SECRET = "testbed-secret"
    OYSTER_BIND_ADDR = "127.0.0.1:3000"
    DATABASE_URL = "sqlite:oyster.db?mode=rwc"
    WALRUS_WORKING_DIR = args.working_dir
    SUI_RPC_URL = sui_rpc_url
  }
  run "./scripts/testbed-setup.sh"
}

service extend {
  wait {
    after @setup
    contains "${ args.working_dir }/client_config.yaml" {
      format = "yaml"
      key = "$.system_object"
      var = walrus_system_object
    }
    contains "${ args.working_dir }/client_config.yaml" {
      format = "yaml"
      key = "$.staking_object"
      var = walrus_staking_object
    }
    contains "${ args.working_dir }/sui_client.yaml" {
      format = "yaml"
      key = "$.envs[?(@.alias == 'local')].rpc"
      var = sui_rpc_url
    }
  }
  env {
    DATABASE_URL = "sqlite:oyster.db?mode=rwc"
    PEARL_GRPC_URL = "http://127.0.0.1:50051"
    PEARL_SERVICE_SECRET = "testbed-secret"
    OYSTER_EXTENSION_METRICS_BIND_ADDR = "127.0.0.1:50053"
    RUST_LOG = "info"
    WALRUS_SYSTEM_OBJECT = walrus_system_object
    WALRUS_STAKING_OBJECT = walrus_staking_object
    SUI_RPC_URL = sui_rpc_url
  }
  run "./target/debug/oysterd extend"
}
